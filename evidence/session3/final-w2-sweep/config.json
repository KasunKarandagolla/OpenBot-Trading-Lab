{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "OpenBot Research PAPER ONLY",
  "cancel_open_orders_on_exit": true,
  "custom_price_max_distance_ratio": 1.0,
  "dataformat_ohlcv": "feather",
  "db_url": "sqlite://",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "entry_pricing": {
    "order_book_top": 1,
    "price_side": "other",
    "use_order_book": true
  },
  "exchange": {
    "ccxt_async_config": {
      "has": {
        "fetchCurrencies": false
      }
    },
    "ccxt_config": {
      "has": {
        "fetchCurrencies": false
      }
    },
    "key": "",
    "name": "binance",
    "pair_blacklist": [],
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "BCH/USDT:USDT",
      "XRP/USDT:USDT",
      "LTC/USDT:USDT",
      "TRX/USDT:USDT",
      "ETC/USDT:USDT",
      "LINK/USDT:USDT",
      "XLM/USDT:USDT",
      "ADA/USDT:USDT",
      "BNB/USDT:USDT",
      "ATOM/USDT:USDT",
      "DOGE/USDT:USDT",
      "DOT/USDT:USDT",
      "SOL/USDT:USDT",
      "UNI/USDT:USDT",
      "AVAX/USDT:USDT",
      "NEAR/USDT:USDT",
      "AAVE/USDT:USDT",
      "FIL/USDT:USDT",
      "OP/USDT:USDT",
      "APT/USDT:USDT",
      "ARB/USDT:USDT",
      "SUI/USDT:USDT"
    ],
    "secret": ""
  },
  "exit_pricing": {
    "order_book_top": 1,
    "price_side": "other",
    "use_order_book": true
  },
  "fee": 0.0005,
  "fiat_display_currency": "",
  "force_entry_enable": false,
  "initial_state": "stopped",
  "internals": {
    "process_throttle_secs": 5
  },
  "lab_audit": false,
  "margin_mode": "isolated",
  "max_open_trades": 2,
  "minimal_roi": {
    "0": 100.0
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "position_adjustment_enable": false,
  "stake_amount": 25,
  "stake_currency": "USDT",
  "stoploss": -0.03,
  "strategy": "LiquiditySweepReversalV1",
  "strategy_path": "/lab/user_data/strategies",
  "telegram": {
    "chat_id": "",
    "enabled": false,
    "token": ""
  },
  "timeframe": "15m",
  "tradable_balance_ratio": 0.99,
  "trading_mode": "futures",
  "unfilledtimeout": {
    "entry": 5,
    "exit": 5,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "user_data_dir": "/lab/user_data"
}
