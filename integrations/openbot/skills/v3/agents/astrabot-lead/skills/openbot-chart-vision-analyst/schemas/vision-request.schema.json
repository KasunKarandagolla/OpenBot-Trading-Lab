{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only chart-vision analysis request",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "requested_by", "purpose", "venue", "market_type", "contract", "timeframes", "decision_asof_utc", "mode", "authority"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "requested_by": {"type": "string", "minLength": 1},
    "purpose": {"enum": ["DISCOVERY", "STRATEGY_FIT", "PRE_ENTRY", "PENDING_ENTRY", "OPEN_POSITION", "MANAGEMENT_RESEARCH", "EXIT_REVIEW", "POST_TRADE"]},
    "venue": {"type": "string", "minLength": 1},
    "market_type": {"const": "LINEAR_USDT_PERPETUAL"},
    "contract": {"type": "string", "minLength": 1},
    "chart_symbol": {"type": ["string", "null"]},
    "timeframes": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["4h", "1h", "15m", "5m", "1d"]}},
    "indicators": {"type": "array", "items": {"type": "string"}, "maxItems": 6},
    "decision_asof_utc": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["LIVE_SNAPSHOT_RESEARCH", "FROZEN_CUTOFF_REPLAY"]},
    "authority": {"enum": ["L0_RESEARCH_ONLY", "L1_COUNTERFACTUAL_ONLY"]},
    "native_strategy_version": {"type": ["string", "null"]},
    "trade_id": {"type": ["string", "null"]},
    "frozen_plan_id": {"type": ["string", "null"]},
    "numeric_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "research_question": {"type": "string", "minLength": 1},
    "chart_image_budget": {"type": "integer", "minimum": 0, "maximum": 8}
  }
}
