{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "openbot.shared.request.v2"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,80}$"
    },
    "kind": {
      "const": "CHART"
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "request_id",
    "kind",
    "created_at_ms",
    "expires_at_ms",
    "payload"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "SCAN"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "universe": {
                "type": "integer",
                "minimum": 24,
                "maximum": 40
              },
              "shortlist": {
                "type": "integer",
                "minimum": 3,
                "maximum": 6
              }
            },
            "required": []
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "CHART"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "run_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]{1,80}$"
              },
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "chart": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "request_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]{1,64}$"
                  },
                  "candidate_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "symbol": {
                    "type": "string",
                    "pattern": "^[A-Z0-9_]{2,32}$"
                  },
                  "venue": {
                    "const": "BINANCE_PUBLIC_USDM"
                  },
                  "cutoff_ms": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "timeframe": {
                    "enum": [
                      "4h",
                      "1h",
                      "15m",
                      "5m",
                      "1m"
                    ]
                  },
                  "visible_candles": {
                    "type": "integer",
                    "minimum": 20,
                    "maximum": 200
                  },
                  "overlays": {
                    "type": "array",
                    "uniqueItems": true,
                    "maxItems": 3,
                    "items": {
                      "enum": [
                        "vwap",
                        "ema20",
                        "ema50",
                        "confirmed_swings"
                      ]
                    }
                  },
                  "volume": {
                    "type": "boolean"
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "start_ms": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end_ms": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "focus_zone": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "required": [
                  "request_id",
                  "candidate_id",
                  "symbol",
                  "venue",
                  "cutoff_ms",
                  "timeframe",
                  "visible_candles",
                  "overlays",
                  "volume",
                  "purpose",
                  "revision"
                ],
                "$schema": "https://json-schema.org/draft/2020-12/schema"
              }
            },
            "required": [
              "run_id",
              "candidate_id",
              "chart"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "GATE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "run_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]{1,80}$"
              },
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "proposal": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "decision": {
                    "enum": [
                      "MARKET",
                      "LIMIT",
                      "CONDITIONAL",
                      "NO_OPPORTUNITY"
                    ]
                  },
                  "venue": {
                    "const": "Binance USD-M Demo"
                  },
                  "symbol": {
                    "type": "string",
                    "pattern": "^[A-Z0-9_]{2,32}$"
                  },
                  "packet_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "side": {
                    "enum": [
                      "LONG",
                      "SHORT"
                    ]
                  },
                  "entry": {
                    "type": "string",
                    "pattern": "^[0-9]{1,12}([.][0-9]{1,12})?$"
                  },
                  "stop": {
                    "type": "string",
                    "pattern": "^[0-9]{1,12}([.][0-9]{1,12})?$"
                  },
                  "tp1": {
                    "type": "string",
                    "pattern": "^[0-9]{1,12}([.][0-9]{1,12})?$"
                  },
                  "tp2": {
                    "type": "string",
                    "pattern": "^[0-9]{1,12}([.][0-9]{1,12})?$"
                  },
                  "quantity": {
                    "type": "string",
                    "pattern": "^[0-9]{1,12}([.][0-9]{1,12})?$"
                  },
                  "leverage": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 25
                  },
                  "expires_at_ms": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "invalidation": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "source_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "available_at_ms": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "anchor_price": {
                        "type": "string",
                        "pattern": "^[0-9]{1,12}([.][0-9]{1,12})?$"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source_sha256",
                      "available_at_ms",
                      "anchor_price",
                      "reason"
                    ]
                  },
                  "trigger": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "CLOSED_5M_ABOVE",
                          "CLOSED_5M_BELOW"
                        ]
                      },
                      "price": {
                        "type": "string",
                        "pattern": "^[0-9]{1,12}([.][0-9]{1,12})?$"
                      },
                      "not_before_ms": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "order_after_confirmation": {
                        "const": true
                      }
                    },
                    "required": [
                      "kind",
                      "price",
                      "not_before_ms",
                      "order_after_confirmation"
                    ]
                  },
                  "revalidation_required": {
                    "const": true
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "engine_mode": {
                    "const": "DEMO_READ_ONLY"
                  },
                  "margin_type": {
                    "const": "ISOLATED"
                  },
                  "position_side": {
                    "const": "BOTH"
                  },
                  "stop_working_type": {
                    "const": "MARK_PRICE"
                  },
                  "hold_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 54000
                  },
                  "exits": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "price": {
                          "type": "string",
                          "pattern": "^[0-9]{1,12}([.][0-9]{1,12})?$"
                        },
                        "quantity": {
                          "type": "string",
                          "pattern": "^[0-9]{1,12}([.][0-9]{1,12})?$"
                        },
                        "reduce_only": {
                          "const": true
                        }
                      },
                      "required": [
                        "price",
                        "quantity",
                        "reduce_only"
                      ]
                    }
                  }
                },
                "required": [
                  "decision",
                  "venue",
                  "symbol",
                  "packet_sha256"
                ],
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "Current validate_market_plan v2 research proposal; no execution authority",
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "decision": {
                          "const": "NO_OPPORTUNITY"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "reason"
                      ]
                    },
                    "else": {
                      "required": [
                        "side",
                        "entry",
                        "stop",
                        "tp1",
                        "tp2",
                        "quantity",
                        "leverage",
                        "expires_at_ms",
                        "invalidation",
                        "engine_mode",
                        "margin_type",
                        "position_side",
                        "stop_working_type",
                        "hold_seconds",
                        "exits"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "decision": {
                          "const": "CONDITIONAL"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "trigger",
                        "revalidation_required"
                      ]
                    }
                  }
                ]
              },
              "native_receipts": {
                "type": "object"
              }
            },
            "required": [
              "run_id",
              "candidate_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "READINESS"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {},
            "required": []
          }
        }
      }
    }
  ]
}
