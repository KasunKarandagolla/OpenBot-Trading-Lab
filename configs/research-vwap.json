{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "timeframe": "15m",
  "strategy": "VWAPTrendContinuationV1",
  "max_open_trades": 2,
  "stake_currency": "USDT",
  "stake_amount": 25,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "",
  "cancel_open_orders_on_exit": true,
  "position_adjustment_enable": false,
  "unfilledtimeout": {
    "entry": 5,
    "exit": 5,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "exchange": {
    "name": "gate",
    "key": "",
    "secret": "",
    "password": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "timeout": 30000
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "timeout": 30000
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "force_entry_enable": false,
  "bot_name": "OpenBot Research PAPER ONLY",
  "initial_state": "stopped",
  "internals": {
    "process_throttle_secs": 5
  },
  "dataformat_ohlcv": "feather",
  "user_data_dir": "/lab/user_data",
  "strategy_path": "/lab/user_data/strategies",
  "db_url": "sqlite:////lab/user_data/research-unused.sqlite",
  "fee": 0.0006,
  "stoploss": -0.03,
  "minimal_roi": {
    "0": 100.0
  },
  "lab_audit": true
}
